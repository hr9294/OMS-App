{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Run OMS Mobile Test",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal"
    },
    {
      "name": "Python: PyTest Mobile Suite",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests/test_oms_mobile.py", "-v", "-s"],
      "console": "integratedTerminal"
    }
  ]
}
